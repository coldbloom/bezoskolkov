# Адрес сайта для ссылок, текста домена, canonical, Open Graph и sitemap.
# Скопируйте настройки в .env.local или окружение сборки: .env.example не загружается.
# Значение фиксируется при сборке; после изменения выполните yarn build.
NEXT_PUBLIC_SITE_URL=https://oknoshield.site

# Только значения content из метатегов подтверждения прав на oknoshield.site.
# Необязательно; пустые значения не добавляют verification-теги в HTML.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Общий номер и отдельный номер для каждой региональной страницы.
# Если региональная переменная не задана, используется +79895052785.
DEFAULT_PHONE=+79895052785
REGION_PHONE_SOUTH=+79895052785
REGION_PHONE_ROSTOV=+79895052785
REGION_PHONE_KRASNODAR=+79895052785
REGION_PHONE_DONETSK=+79895052785
REGION_PHONE_LUGANSK=+79895052785
REGION_PHONE_CRYM=+79895052785

# Базовый URL сервиса, совместимого с medtaxi-evp: POST <base>/feedback.
# Например /api, если хостинг проксирует /api/feedback в российский backend.
# Без адреса API форма показывает контактный телефон и не отправляет данные.
NEXT_PUBLIC_API_URL=

# Публичные реквизиты оператора ОКНО ЩИТ (попадут в готовый HTML).
# Укажите настоящего владельца и адрес для обращений; не только бренд.
# Без NAME и ADDRESS онлайн-заявки выключены. Почта/ИНН необязательны.
PERSONAL_DATA_OPERATOR_NAME=
PERSONAL_DATA_OPERATOR_ADDRESS=
PERSONAL_DATA_OPERATOR_INN=
PERSONAL_DATA_CONTACT_EMAIL=

# Если заявки обрабатывает стороннее лицо по поручению оператора:
PERSONAL_DATA_PROCESSOR_NAME=
PERSONAL_DATA_PROCESSOR_ADDRESS=
